<%- include('../partials/header') %>

<main class="container admin-container" style="padding: 40px 20px;">
    <!-- Admin Header -->
    <div class="admin-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div>
            <h2>Welcome back, <%= user.name %></h2>
            <p style="color: var(--text-muted);">Nestfinders Realty Executive Overview</p>
        </div>
        <a href="/admin/logout" class="btn-danger" style="padding: 8px 16px; font-size: 0.9rem;">Logout</a>
    </div>

    <!-- Quick Stats Metric Cards -->
    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
        <div class="stat-card" style="background: var(--surface); padding: 20px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <h3 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Total Properties</h3>
            <p style="font-size: 2.2rem; font-weight: 700; color: var(--primary); margin-top: 5px;"><%= stats.totalProperties %></p>
        </div>

        <div class="stat-card" style="background: var(--surface); padding: 20px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <h3 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Total Inquiries</h3>
            <p style="font-size: 2.2rem; font-weight: 700; color: var(--dark); margin-top: 5px;"><%= stats.totalInquiries %></p>
        </div>

        <div class="stat-card" style="background: var(--surface); padding: 20px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <h3 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Pending Inquiries</h3>
            <p style="font-size: 2.2rem; font-weight: 700; color: var(--secondary); margin-top: 5px;"><%= stats.pendingInquiries %></p>
        </div>

        <div class="stat-card" style="background: var(--surface); padding: 20px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
            <h3 style="font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Agent Verifications</h3>
            <p style="font-size: 2.2rem; font-weight: 700; color: #0284c7; margin-top: 5px;"><%= typeof pendingVerificationsCount !== 'undefined' ? pendingVerificationsCount : 0 %></p>
        </div>
    </div>

    <!-- Admin Navigation Quick Actions -->
    <div class="admin-actions" style="display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap;">
        <a href="/admin/properties" class="btn">Manage Properties</a>
        <a href="/admin/verifications" class="btn-secondary">Review Agent Verifications</a>
    </div>

    <hr style="border: 0; border-top: 1px solid var(--border); margin-bottom: 30px;">

    <!-- Recent Customer Inquiries Table -->
    <h3>Recent Client Inquiries</h3>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Client Name</th>
                <th>Email / Phone</th>
                <th>Property Reference</th>
                <th>Message</th>
                <th>Status</th>
                <th>Update Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (inquiries && inquiries.length > 0) { %>
                <% inquiries.forEach(item => { %>
                    <tr>
                        <td><%= new Date(item.createdAt).toLocaleDateString() %></td>
                        <td><strong><%= item.name %></strong></td>
                        <td>
                            <%= item.email %><br>
                            <small style="color: var(--text-muted);"><%= item.phone %></small>
                        </td>
                        <td>
                            <% if (item.property) { %>
                                <a href="/properties/<%= item.property._id %>" target="_blank" style="color: var(--primary); font-weight: 600;">
                                    <%= item.property.title %>
                                </a>
                            <% } else { %>
                                <span style="color: var(--text-muted);">General Contact</span>
                            <% } %>
                        </td>
                        <td style="max-width: 250px; font-size: 0.85rem;"><%= item.message %></td>
                        <td>
                            <span class="badge badge-<%= item.status.toLowerCase() %>">
                                <%= item.status %>
                            </span>
                        </td>
                        <td>
                            <form action="/admin/inquiry/update-status" method="POST">
                                <input type="hidden" name="inquiryId" value="<%= item._id %>">
                                <select name="status" onchange="this.form.submit()" style="padding: 6px; font-size: 0.85rem; border-radius: 4px;">
                                    <option value="Pending" <%= item.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Contacted" <%= item.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                                    <option value="Resolved" <%= item.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">
                        No customer inquiries found.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>

<%- include('../partials/footer') %>