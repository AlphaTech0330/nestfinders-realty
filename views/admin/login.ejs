<%- include('../partials/header') %>

<main class="container" style="padding: 60px 20px;">
    <div class="login-box" style="max-width: 450px; margin: 0 auto;">
        <h2 style="margin-bottom: 10px; text-align: center;">Admin Portal Login</h2>
        <p style="color: var(--text-muted); text-align: center; margin-bottom: 25px;">
            Enter your credentials to access the administrative dashboard.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: var(--danger-bg); border: 1px solid #fecaca; color: var(--danger-text); padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem;">
                ✖ <%= error %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required placeholder="admin@nestfindersrealty.com">
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required placeholder="••••••••">
            </div>

            <button type="submit" class="btn" style="width: 100%; margin-top: 10px;">Login to Dashboard</button>
        </form>
    </div>
</main>

<%- include('../partials/footer') %>